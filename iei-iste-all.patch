@@ -0,0 +1,27 @@
+.gallery-section { overflow: hidden; }
+.gallery { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(28px, 5vh, 64px) clamp(16px, 2vw, 32px); margin-top: clamp(40px, 8vh, 96px); align-items: start; }
+.shot { margin: 0; }
+.shot__open { display: block; width: 100%; padding: 0; background: none; border: 0; cursor: zoom-in; }
+.shot figcaption { display: flex; gap: 14px; justify-content: space-between; padding-top: 10px; color: var(--ink-3); }
+.shot figcaption strong { font-weight: 400; color: var(--ink-2); }
+.shot--1 { grid-column: 1 / 8; }
+.shot--2 { grid-column: 9 / 13; margin-top: 18vh; }
+.shot--3 { grid-column: 2 / 6; }
+.shot--4 { grid-column: 6 / 13; margin-top: 10vh; }
+.shot--5 { grid-column: 1 / 13; }
+.shot--6 { grid-column: 4 / 9; }
+
+.lightbox { padding: 0; border: 0; width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; background: rgba(5,6,5,.96); color: var(--ink); }
+.lightbox::backdrop { background: rgba(0,0,0,.8); }
+.lightbox__inner { display: grid; grid-template-rows: 1fr auto; height: 100%; padding: 24px; gap: 16px; }
+.lightbox__stage { position: relative; }
+.lightbox__stage img { object-fit: contain; }
+.lightbox__bar { display: flex; justify-content: space-between; gap: 16px; align-items: center; color: var(--ink-2); }
+.lightbox__ctrl { display: flex; gap: 8px; }
+.lightbox__ctrl button { font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--ink); background: none; border: 1px solid var(--line-2); padding: 10px 14px; cursor: pointer; }
+.lightbox__ctrl button:hover { border-color: var(--em); color: var(--em); }
+
+@media (max-width: 900px) {
+  .gallery { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(var(--gutter) * -1); padding: 0 var(--gutter) 16px; -webkit-overflow-scrolling: touch; }
+  .shot, .shot--2, .shot--4 { flex: 0 0 82vw; margin-top: 0; scroll-snap-align: center; }
+}
diff --git a/src/app/styles/nav.css b/src/app/styles/nav.css
new file mode 100644
index 0000000..5a7de97
--- /dev/null
+++ b/src/app/styles/nav.css
@@ -0,0 +1,28 @@
+.nav { position: fixed; inset: 0 0 auto 0; z-index: 50; }
+.nav__bar { display: flex; align-items: center; gap: 32px; height: var(--nav-h); padding: 0 var(--gutter); border-bottom: 1px solid transparent; transition: background .4s, border-color .4s, backdrop-filter .4s; }
+.nav.is-solid .nav__bar, .nav.is-open .nav__bar { background: rgba(10,11,10,.86); backdrop-filter: blur(10px); border-color: var(--line); }
+.nav__links { display: flex; gap: 28px; margin-left: auto; }
+.nav__links a { font-family: var(--f-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); padding: 6px 0; border-bottom: 1px solid transparent; transition: color .25s, border-color .25s; }
+.nav__links a:hover, .nav__links a[aria-current="true"] { color: var(--ink); border-color: var(--em); }
+.nav__cta { font-family: var(--f-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; padding: 10px 16px; border: 1px solid var(--line-2); transition: border-color .3s, color .3s; }
+.nav__cta:hover { border-color: var(--em); color: var(--em); }
+.burger { display: none; margin-left: auto; width: 44px; height: 44px; background: none; border: 0; position: relative; cursor: pointer; }
+.burger span { position: absolute; left: 10px; right: 10px; height: 1px; background: var(--ink); transition: transform .3s var(--ease), top .3s var(--ease); }
+.burger span:first-child { top: 18px; } .burger span:last-child { top: 26px; }
+.is-open .burger span:first-child { top: 22px; transform: rotate(45deg); }
+.is-open .burger span:last-child { top: 22px; transform: rotate(-45deg); }
+.menu { display: none; }
+
+@media (max-width: 960px) {
+  .nav__links, .nav__cta { display: none; }
+  .burger { display: block; }
+  .menu:not([hidden]) {
+    display: flex; flex-direction: column; justify-content: space-between;
+    position: fixed; inset: var(--nav-h) 0 0 0; padding: 24px var(--gutter) 32px;
+    background: var(--bg); overflow-y: auto;
+  }
+  .menu nav { display: flex; flex-direction: column; }
+  .menu a { display: flex; align-items: baseline; gap: 18px; padding: 18px 0; border-bottom: 1px solid var(--line); font-family: var(--f-display); font-size: 42px; line-height: 1; }
+  .menu a em { font-family: var(--f-mono); font-style: normal; font-size: 11px; color: var(--em); letter-spacing: .12em; }
+  .menu p { font-family: var(--f-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
+}
diff --git a/src/app/styles/opening.css b/src/app/styles/opening.css
new file mode 100644
index 0000000..76186b8
--- /dev/null
+++ b/src/app/styles/opening.css
@@ -0,0 +1,42 @@
+.opening { position: relative; z-index: 1; }
+.journey--room .beat, .journey--digital .beat { min-height: 100vh; min-height: 100svh; }
+.journey--digital .beat { min-height: 140vh; }
+.beat { position: relative; display: flex; flex-direction: column; justify-content: center; padding: 0 var(--gutter); }
+.beat--hero { padding-top: var(--nav-h); padding-bottom: 72px; gap: 20px; max-width: 1100px; }
+.hero__title { margin: 0; font-family: var(--f-display); font-weight: 400; font-size: clamp(52px, min(11vw, 15.5vh), 168px); line-height: .9; letter-spacing: -.02em; }
+.hero__title span { display: block; }
+.hero__accent { font-style: italic; color: var(--em); }
+.hero__desc { max-width: 460px; margin: 0; color: var(--ink-2); font-size: clamp(16px, 1.3vw, 19px); }
+.hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
+.hero__scroll { position: absolute; left: var(--gutter); bottom: 28px; color: var(--ink-3); display: flex; align-items: center; gap: 14px; }
+.hero__scroll i { width: 48px; height: 1px; background: var(--em); display: block; }
+.hero__side { position: absolute; right: var(--gutter); bottom: 28px; color: var(--ink-3); writing-mode: vertical-rl; }
+.cap { margin: 0; max-width: 14em; font-family: var(--f-display); font-style: italic; font-size: clamp(34px, 5.2vw, 84px); line-height: 1.02; letter-spacing: -.01em; text-shadow: 0 2px 30px rgba(0,0,0,.6); }
+.beat--right { align-items: flex-end; text-align: right; }
+.beat--gate { align-items: center; justify-content: flex-end; padding-bottom: 14vh; gap: 20px; text-align: center; }
+.gate__link { font-family: var(--f-display); font-size: clamp(36px, 6vw, 88px); line-height: 1; border-bottom: 1px solid var(--em-dim); padding-bottom: 8px; transition: color .3s, border-color .3s; }
+.gate__link:hover { color: var(--em); border-color: var(--em); }
+
+/* HUD */
+.hud { position: fixed; z-index: 45; left: var(--gutter); right: var(--gutter); bottom: 22px; display: flex; gap: 24px; color: var(--ink-3); pointer-events: none; transition: opacity .4s; }
+.hud span:nth-child(2) { color: var(--ink-2); }
+.hud span:nth-child(n+3) { margin-left: auto; }
+.hud span:nth-child(n+4) { margin-left: 0; }
+.hud__rec { color: var(--em); display: inline-flex; align-items: center; gap: 8px; }
+.hud__rec i { width: 6px; height: 6px; border-radius: 50%; background: var(--em); animation: pulse 1.6s ease-in-out infinite; }
+.hud__skip { position: fixed; z-index: 45; right: var(--gutter); top: calc(var(--nav-h) + 14px); font-family: var(--f-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); transition: color .3s, opacity .4s; }
+.hud__skip:hover { color: var(--em); }
+.hud.is-hidden, .hud.is-hidden + .hud__skip { opacity: 0; pointer-events: none; }
+.hero__scroll, .hero__side { z-index: 1; }
+
+/* Curtain: content slides over the final gateway frame */
+.curtain { position: relative; z-index: 2; background: var(--bg); border-top: 1px solid var(--em-dim); box-shadow: 0 -60px 80px rgba(0,0,0,.7); }
+
+@media (max-width: 640px) {
+  .hud span:nth-child(3) { display: none; }
+  .hud { bottom: 14px; gap: 14px; }
+  .hero__scroll { bottom: 44px; }
+  .hero__side { display: none; }
+  .hud__skip { top: auto; bottom: 40px; right: var(--gutter); }
+  .beat--right { align-items: flex-start; text-align: left; }
+}
diff --git a/src/app/styles/sections.css b/src/app/styles/sections.css
new file mode 100644
index 0000000..79321d5
--- /dev/null
+++ b/src/app/styles/sections.css
@@ -0,0 +1,96 @@
+.section { padding: var(--sec-y) 0; border-bottom: 1px solid var(--line); }
+
+/* About */
+.about__body { display: grid; grid-template-columns: 220px 1fr 1fr; gap: clamp(24px, 4vw, 64px); margin-top: clamp(40px, 8vh, 96px); align-items: start; }
+.about__meta { margin: 0; display: grid; gap: 18px; }
+.about__meta dt { color: var(--ink-3); margin-bottom: 4px; }
+.about__meta dd { margin: 0; font-size: 14px; color: var(--ink-2); }
+.about__lead { margin: 0; font-family: var(--f-display); font-size: clamp(24px, 2.6vw, 38px); line-height: 1.15; }
+.about__desc { margin: 0; color: var(--ink-2); max-width: 44ch; }
+.pillars { list-style: none; margin: clamp(56px, 10vh, 120px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
+.pillar { position: relative; padding: 32px 28px 40px 0; border-right: 1px solid var(--line); padding-left: 28px; }
+.pillar:first-child { padding-left: 0; } .pillar:last-child { border-right: 0; }
+.pillar__n { font-family: var(--f-display); font-style: italic; font-size: 20px; color: var(--em); }
+.pillar__t { margin: 28px 0 10px; font-family: var(--f-display); font-weight: 400; font-size: clamp(26px, 2.4vw, 36px); line-height: 1.05; }
+.pillar__d { margin: 0; color: var(--ink-2); font-size: 15px; max-width: 30ch; }
+.pillar__arrow { position: absolute; right: 24px; top: 28px; color: var(--ink-3); transition: color .3s, transform .3s var(--ease); }
+.pillar:hover .pillar__arrow { color: var(--em); transform: translate(3px,-3px); }
+
+/* Events — asymmetric showcases */
+.events__intro { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: end; margin-bottom: clamp(56px, 10vh, 120px); }
+.events__aside { display: grid; gap: 20px; justify-items: start; color: var(--ink-2); max-width: 36ch; }
+.events__aside p { margin: 0; }
+.event-list { display: grid; gap: clamp(72px, 12vh, 150px); }
+.event { display: grid; grid-template-columns: repeat(12, 1fr); gap: 0 clamp(16px, 2vw, 32px); align-items: end; }
+.event__media { grid-column: 1 / 9; grid-row: 1; }
+.event__body { grid-column: 9 / 13; grid-row: 1; display: grid; gap: 14px; justify-items: start; padding-bottom: 8px; position: relative; }
+.event--2 .event__media { grid-column: 6 / 13; }
+.event--2 .event__body { grid-column: 1 / 6; }
+.event--3 .event__media { grid-column: 1 / 13; grid-row: 1; }
+.event--3 .event__body { grid-column: 1 / 8; grid-row: 2; margin-top: 28px; }
+.event__num { font-family: var(--f-display); font-size: clamp(80px, 11vw, 168px); line-height: .8; color: transparent; -webkit-text-stroke: 1px var(--line-2); }
+.event__cat { margin: 0; color: var(--em); }
+.event__title { margin: 0; font-family: var(--f-display); font-weight: 400; font-size: clamp(34px, 3.8vw, 58px); line-height: 1; }
+.event__desc { margin: 0; color: var(--ink-2); max-width: 34ch; }
+.event__meta { margin: 6px 0 10px; padding: 14px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); width: 100%; }
+.event__meta div { display: flex; justify-content: space-between; gap: 16px; }
+.event__meta dt { color: var(--ink-3); } .event__meta dd { margin: 0; font-size: 14px; color: var(--ink-2); }
+.events__note, .team__note { margin: clamp(48px, 8vh, 96px) 0 0; color: var(--ink-3); text-align: center; }
+
+/* Team — directory */
+.team__intro { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: end; margin-bottom: clamp(48px, 8vh, 96px); }
+.team__aside { display: grid; gap: 22px; justify-items: start; color: var(--ink-2); max-width: 38ch; }
+.team__aside p { margin: 0; }
+.directory { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(32px, 5vw, 96px); align-items: start; }
+.directory__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
+.member { display: grid; grid-template-columns: 48px 1fr auto 0; align-items: center; gap: 16px; width: 100%; padding: 22px 0; text-align: left; background: none; border: 0; border-bottom: 1px solid var(--line); color: var(--ink-3); cursor: pointer; transition: color .3s, padding .4s var(--ease); font: inherit; }
+.member.is-active, .member:hover { color: var(--ink); padding-left: 14px; }
+.member__idx { color: var(--em); }
+.member__main { display: grid; gap: 4px; }
+.member__name { font-family: var(--f-display); font-size: clamp(28px, 3.4vw, 52px); line-height: 1; }
+.member__name.is-placeholder { font-style: italic; }
+.member__role { font-family: var(--f-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
+.member__thumb { display: none; }
+.directory__preview { position: sticky; top: calc(var(--nav-h) + 24px); display: grid; gap: 16px; }
+.directory__caption { display: flex; justify-content: space-between; gap: 12px; color: var(--ink-3); }
+.directory__caption strong { font-weight: 400; color: var(--ink); }
+.directory__bio { margin: 0; color: var(--ink-2); font-size: 15px; min-height: 3em; }
+
+/* Contact */
+.contact { padding-bottom: clamp(96px, 16vh, 200px); }
+.contact__title { font-size: clamp(54px, 10.5vw, 168px); }
+.contact__row { display: grid; grid-template-columns: 1fr 1.3fr; gap: 48px; margin-top: clamp(48px, 9vh, 110px); align-items: end; }
+.contact__copy { margin: 0; color: var(--ink-2); max-width: 36ch; }
+.contact__cta { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 6px 24px; padding: 26px 0; border-top: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); font-family: var(--f-display); font-size: clamp(34px, 5vw, 72px); line-height: 1; transition: color .3s, border-color .3s, padding .4s var(--ease); }
+.contact__cta small { grid-column: 1 / -1; font-family: var(--f-mono); font-size: 11px; letter-spacing: .12em; color: var(--ink-3); }
+.contact__arrow { color: var(--em); transition: transform .4s var(--ease); }
+.contact__cta:hover { color: var(--em); border-color: var(--em); padding-left: 12px; }
+.contact__cta:hover .contact__arrow { transform: translate(6px,-6px); }
+
+/* Footer */
+.footer { padding: 56px 0 28px; }
+.footer__grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 40px; padding-bottom: 48px; }
+.footer__brand p { margin: 14px 0 0; color: var(--ink-2); font-size: 15px; max-width: 30ch; }
+.footer__nav { display: grid; gap: 8px; align-content: start; }
+.footer__nav a, .footer__where a { color: var(--ink-2); font-size: 15px; transition: color .25s; }
+.footer__nav a:hover, .footer__where a:hover { color: var(--em); }
+.footer__where { display: grid; gap: 8px; align-content: start; color: var(--ink-3); font-size: 14px; }
+.footer__bar { display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; padding-top: 20px; border-top: 1px solid var(--line); color: var(--ink-3); }
+.footer__bar a:hover { color: var(--em); } .footer__end { color: var(--em-dim); }
+
+@media (max-width: 900px) {
+  .about__body { grid-template-columns: 1fr; }
+  .pillars { grid-template-columns: 1fr; }
+  .pillar, .pillar:first-child { padding: 28px 0; border-right: 0; border-bottom: 1px solid var(--line); }
+  .events__intro, .team__intro, .contact__row { grid-template-columns: 1fr; gap: 28px; }
+  .event { display: block; }
+  .event__media { margin-bottom: 20px; }
+  .event__num { font-size: 72px; }
+  .directory { grid-template-columns: 1fr; }
+  .directory__preview { display: none; }
+  .member { grid-template-columns: 36px 1fr 64px; }
+  .member__society { display: none; }
+  .member__thumb { display: block; width: 64px; }
+  .member.is-active, .member:hover { padding-left: 0; }
+  .footer__grid { grid-template-columns: 1fr; gap: 28px; }
+}
