@@ -0,0 +1,57 @@
+import Image from "next/image";
+
+interface FrameProps {
+  src?: string;
+  alt: string;
+  /** CSS aspect-ratio value, e.g. "16 / 10". */
+  ratio: string;
+  /** Shown inside the placeholder, e.g. "PORTRAIT". */
+  label?: string;
+  sizes?: string;
+  priority?: boolean;
+  className?: string;
+}
+
+/**
+ * A photograph slot. With `src` it renders the real image; without it, an
+ * art-directed placeholder with crop marks so layouts can be judged before
+ * photography exists. Swap images by editing src/app/data/site.ts.
+ */
+export default function Frame({
+  src,
+  alt,
+  ratio,
+  label = "PHOTOGRAPH",
+  sizes = "(max-width: 900px) 100vw, 60vw",
+  priority,
+  className = "",
+}: FrameProps) {
+  return (
+    <div
+      className={`frame ${src ? "frame--filled" : "frame--empty"} ${className}`}
+      style={{ aspectRatio: ratio }}
+    >
+      {src ? (
+        <Image
+          src={src}
+          alt={alt}
+          fill
+          sizes={sizes}
+          priority={priority}
+          className="frame__img"
+        />
+      ) : (
+        <>
+          <span className="frame__tick frame__tick--tl" aria-hidden />
+          <span className="frame__tick frame__tick--tr" aria-hidden />
+          <span className="frame__tick frame__tick--bl" aria-hidden />
+          <span className="frame__tick frame__tick--br" aria-hidden />
+          <span className="frame__label">
+            {label}
+            <small>{ratio.replace(/\s/g, "")} · placeholder</small>
+          </span>
+        </>
+      )}
+    </div>
+  );
+}
